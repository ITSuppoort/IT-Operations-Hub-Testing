        )}

        {/* KPI CARDS */}

        <div className="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-5">

          <KpiCard
            title="Equipos"
            value={data.equipment.total}
            description={`${data.equipment.active} activos`}
            icon={Boxes}
            iconClass="bg-violet-500/10 text-violet-400"
          />

          <KpiCard
            title="Componentes"
            value={data.components.totalUnits}
            description={`${data.components.totalTypes} tipos registrados`}
            icon={Package}
            iconClass="bg-cyan-500/10 text-cyan-400"
          />

          <KpiCard
            title="DaÃ±os"
            value={data.damages.total}
            description={`${data.damages.open} abiertos`}
            icon={Wrench}
            iconClass="bg-red-500/10 text-red-400"
          />

          <KpiCard
