  icon: Icon,
  title,
  description,
  compact = false,
}: {
  icon: React.ElementType;
  title: string;
  description: string;
  compact?: boolean;
}) {
  return (
    <div
      className={`flex flex-col items-center justify-center text-center ${
        compact ? "py-3" : "py-8"
      }`}
    >
      <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-white/[0.035] text-slate-600">
        <Icon size={20} />
      </div>

      <p className="mt-3 text-sm font-medium text-slate-300">
        {title}
      </p>

      <p className="mt-1 max-w-sm text-xs leading-5 text-slate-600">
        {description}
      </p>
    </div>
  );
}

function SkeletonCard() {
  return (
    <div className="h-[145px] animate-pulse rounded-2xl border border-white/[0.06] bg-[#0b1424]" />
  );
}

function SkeletonPanel({
  className = "",
}: {
  className?: string;
}) {
  return (
    <div
      className={`h-[300px] animate-pulse rounded-2xl border border-white/[0.06] bg-[#0b1424] ${className}`}
    />
  );
}

function formatDate(value: string) {
  if (!value) {
    return "No disponible";
  }

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return value;
  }

  return date.toLocaleString("es-DO", {
    dateStyle: "short",
    timeStyle: "short",
  });
}
