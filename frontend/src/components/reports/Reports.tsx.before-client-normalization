                  {data.components.lowStock.slice(0, 6).map((component) => (
                    <div
                      key={component.id}
                      className="flex items-center justify-between rounded-xl border border-red-400/10 bg-red-400/[0.035] px-4 py-3"
                    >
                      <div>
