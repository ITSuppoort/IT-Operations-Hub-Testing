                  className="text-emerald-400"
                />

              </div>

            </div>
          </ReportPanel>

        </div>

        {/* CATEGORIES + MOVEMENTS */}

        <div className="mt-5 grid gap-5 xl:grid-cols-2">

          <ReportPanel
            title="Equipos por categorÃ­a"
            description="DistribuciÃ³n de activos registrados"
            icon={Boxes}
          >
            {data.equipment.byCategory.length === 0 ? (
              <EmptyState
                icon={Boxes}
