  AlertTriangle,
  BarChart3,
  Boxes,
  CheckCircle2,
  Clock3,
  Database,
  Package,
  RefreshCw,
  ShieldAlert,
  TrendingUp,
  Users,
  Wrench,
} from "lucide-react";
type EquipmentReport = {
  total: number;
  active: number;
  inactive: number;
  available: number;
  assigned: number;
  damaged: number;
  byCategory: Array<{
    category: string | null;
    _count: {
      id: number;
    };
  }>;
  byDepartment: Array<{
    departmentId: string | null;
    _count: {
      id: number;
    };
  }>;
};

type ComponentReport = {
  totalTypes: number;
  totalUnits: number;
  lowStockCount: number;
  lowStock: Array<{
    id: string;
    type: string;
    quantity: number;
    minimumStock: number;
    [key: string]: unknown;
  }>;
  components: Array<{
    id: string;
    type: string;
    quantity: number;
    minimumStock: number;
    [key: string]: unknown;
  }>;
};

type DamageReport = {
  total: number;
  open: number;
  inProgress: number;
  repaired: number;
  cancelled: number;
  highPriority: number;
};

type MovementReport = {
  total: number;
  recent: Array<Record<string, unknown>>;
};

type PositionReport = {
  total: number;
  empty: number;
  occupied: number;
};

type ReportsData = {
  generatedAt: string;
  equipment: EquipmentReport;
  components: ComponentReport;
  damages: DamageReport;
  movements: MovementReport;
  positions: PositionReport;
};

type ReportsResponse = {
  generatedAt?: string;
  data?: ReportsData;
  message?: string;
};

export default function Reports() {
  const [data, setData] = useState<ReportsData | null>(null);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  const loadReports = useCallback(async (manual = false) => {
    try {
      if (manual) {
        setRefreshing(true);
      } else {
        setLoading(true);
      }

      setError("");

      const response = await apiRequest(`/reports`, {
        method: "GET",
        cache: "no-store",
      });

      if (!response.ok) {
        throw new Error(
          `El servidor respondiÃ³ con HTTP ${response.status}.`,
        );
      }

      const result: ReportsResponse = await response.json();

      const reportData = result.data ?? result;

      if (
        !reportData ||
        !("equipment" in reportData) ||
        !("components" in reportData)
      ) {
        throw new Error(
          "El backend respondiÃ³, pero el formato del reporte no es vÃ¡lido.",
        );
      }

      setData(reportData as ReportsData);
    } catch (requestError) {
      const message =
        requestError instanceof Error
          ? requestError.message
          : "No fue posible cargar los reportes.";

      setError(message);
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }, []);

  useEffect(() => {
    loadReports();
  }, [loadReports]);

  const equipmentUtilization = useMemo(() => {
    if (!data?.equipment.total) {
      return 0;
    }

    return Math.round(
      (data.equipment.assigned / data.equipment.total) * 100,
    );
  }, [data]);

  const positionOccupation = useMemo(() => {
    if (!data?.positions.total) {
      return 0;
    }

    return Math.round(
      (data.positions.occupied / data.positions.total) * 100,
    );
  }, [data]);

  const equipmentStatus = useMemo(() => {
    if (!data) {
      return [];
    }

    return [
      {
        label: "Activos",
        value: data.equipment.active,
        icon: CheckCircle2,
        className: "text-emerald-400",
        bar: "bg-emerald-400",
      },
      {
        label: "Disponibles",
        value: data.equipment.available,
        icon: Package,
        className: "text-cyan-400",
        bar: "bg-cyan-400",
      },
      {
        label: "Asignados",
        value: data.equipment.assigned,
        icon: Users,
        className: "text-violet-400",
        bar: "bg-violet-400",
      },
      {
        label: "DaÃ±ados",
        value: data.equipment.damaged,
        icon: AlertTriangle,
        className: "text-red-400",
        bar: "bg-red-400",
