                  }}
                >
                  <div className="flex h-32 w-32 flex-col items-center justify-center rounded-full bg-[#0b1424]">
                    <span className="text-3xl font-bold text-white">
                      {equipmentUtilization}%
                    </span>

                    <span className="mt-1 text-xs text-slate-500">
                      asignados
                    </span>
                  </div>
                </div>

                <p className="mt-5 text-sm font-medium text-slate-300">
                  UtilizaciÃ³n de equipos
                </p>

                <p className="mt-1 text-center text-xs text-slate-500">
                  Equipos actualmente asignados a personas o posiciones.
                </p>
              </div>

            </div>
          </ReportPanel>

          <ReportPanel
            title="DaÃ±os y reparaciones"
            description="Estado de incidencias"
            icon={Wrench}
          >
            <div className="space-y-3">

              <MetricRow
                label="Abiertos"
                value={data.damages.open}
