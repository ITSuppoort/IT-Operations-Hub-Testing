  /* =======================================================
     ESTADOS
     ======================================================= */

  const status: StatusItem[] = [
    {
      name: 'En uso',
      value: summary.assigned,
      icon: Users,
      variant: 'blue',
    },
    {
      name: 'Disponibles',
      value: summary.available,
      icon: CheckCircle2,
      variant: 'green',
    },
    {
      name: 'DaÃ±ados',
      value: summary.damaged,
      icon: CircleAlert,
      variant: 'red',
    },
    {
      name: 'En reparaciÃ³n',
      value: summary.repairs,
      icon: Wrench,
      variant: 'orange',
    },
  ]

  /* =======================================================
     PORCENTAJES
     ======================================================= */

  const statusTotal = Math.max(
    summary.totalAssets,
    status.reduce((total, item) => total + item.value, 0),
  )

  const equipmentTotal = equipment.reduce(
    (total, item) => total + item.value,
    0,
  )

  const donutGradient = useMemo(() => {
    if (equipmentTotal <= 0) {
      return 'conic-gradient(#272735 0deg 360deg)'
    }

    let current = 0

    const colors = [
      '#8b5cf6',
      '#3b82f6',
      '#f97316',
    ]

    const segments = equipment.map((item, index) => {
      const start = current
      const degrees = (item.value / equipmentTotal) * 360
      current += degrees

      return `${colors[index]} ${start}deg ${current}deg`
    })

    return `conic-gradient(${segments.join(', ')})`
  }, [equipment, equipmentTotal])

  /* =======================================================
     FECHA
     ======================================================= */

  const currentDate = new Intl.DateTimeFormat('es-DO', {
    weekday: 'long',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date())

  /* =======================================================
