  });

  /*
   * Última actualización.
   */

  if (
    user.updatedAt &&
    user.updatedAt !==
      user.createdAt
  ) {
    activities.push({
      id: `updated-${user.id}`,

      type: "UPDATED",

      title:
        "Información actualizada",

      description:
        "Los datos del usuario fueron modificados.",

      date:
        user.updatedAt,
    });
  }

  /*
   * Equipos actualmente asociados.
   */

  user.equipment?.forEach(
    (equipment) => {
      activities.push({
        id:
          `equipment-${equipment.id}`,

        type: "EQUIPMENT",

        title:
          "Equipo asociado",

        description:
          `${
            getEquipmentName(
              equipment,
            ) ||
            "Equipo"
          } · ${
            equipment.assetTag ||
            equipment.serial ||
            "Sin identificador"
          }`,

        date:
          equipment.updatedAt ||
          equipment.entryDate,
      });
    },
  );

  /*
   * Posición actual.
   */

  if (user.position) {
    activities.push({
      id:
        `position-${user.position.id}`,

      type: "POSITION",

      title:
        "Posición asociada",

      description:
        `${
          user.position.name ||
          user.position.code
        }`,

      date:
        user.position.updatedAt,
    });
  }

  return activities.sort(
    (a, b) => {
      const dateA =
        a.date
          ? new Date(
              a.date,
            ).getTime()
          : 0;

      const dateB =
        b.date
          ? new Date(
              b.date,
            ).getTime()
          : 0;

      return dateB - dateA;
    },
  );
};

  const locations = useMemo(() => {
