function StatCard({
  icon: Icon,
  label,
  value,
  description,
  tone = "violet",
  progress = 0,
  progressLabel = "Progreso",
}: {
  icon: typeof UsersIcon;
  label: string;
  value: number;
  description: string;
  progress?: number;
  progressLabel?: string;
  tone?: "violet" | "blue" | "green" | "red" | "yellow";
}) {
  const toneClasses = {
    violet: {
      icon: "bg-violet-500/10 text-violet-400",
      bar: "bg-violet-400",
      border: "hover:border-violet-400/20",
    },

    blue: {
      bar: "bg-sky-400",
      icon: "bg-blue-500/10 text-blue-400",
      border: "hover:border-blue-400/20",
    },

    green: {
      bar: "bg-emerald-400",
      icon: "bg-emerald-500/10 text-emerald-400",
      border: "hover:border-emerald-400/20",
    },

    red: {
      bar: "bg-rose-400",
      icon: "bg-red-500/10 text-red-400",
      border: "hover:border-red-400/20",
    },

    yellow: {
      bar: "bg-amber-400",
      icon: "bg-amber-500/10 text-amber-400",
      border: "hover:border-amber-400/20",
    },
  };

  const selectedTone = toneClasses[tone];

  return (
    <div
      className={`
        group
        rounded-2xl
        border
        border-slate-400/[0.18]
        bg-[#17233a]
        p-5
        transition
        ${selectedTone.border}
      `}
    >
      <div className="flex items-start justify-between">
        <div>
          <p className="text-xs font-medium uppercase tracking-wider text-slate-500">
            {label}
          </p>

          <p className="mt-2 text-3xl font-bold text-white">{value}</p>

          <p className="mt-1 text-xs text-slate-400">{description}</p>
        </div>

        <div
          className={`
            flex
            h-10
            w-10
            items-center
            justify-center
            rounded-xl
            ${selectedTone.icon}
          `}
        >
          <Icon size={18} />
        </div>
      </div>
      <div className="mt-5 flex items-center justify-between text-[10px] text-slate-300">
        <span>{progressLabel}</span>
        <span className="font-semibold tabular-nums">{Math.round(Math.max(0, Math.min(100, progress)))}%</span>
      </div>
      <div className="mt-2 h-1.5 overflow-hidden rounded-full bg-slate-500/30" role="progressbar"
           aria-valuemin={0} aria-valuemax={100} aria-valuenow={Math.round(Math.max(0, Math.min(100, progress)))}>
        <div className={`h-full rounded-full transition-all duration-500 ${selectedTone.bar}`}
             style={{ width: `${Math.max(0, Math.min(100, progress))}%` }} />
      </div>
    </div>
  );
}

