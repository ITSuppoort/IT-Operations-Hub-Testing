};

const toggleUserStatus = async (
  user: InventoryPerson,
) => {
  const currentStatus =
    user.status.toUpperCase();

    const newStatus = currentStatus === "ACTIVE" ? "INACTIVE" : "ACTIVE";

    const actionText = newStatus === "ACTIVE" ? "activar" : "desactivar";

    const confirmed = window.confirm(
      `¿Seguro que deseas ${actionText} a ${user.firstName} ${user.lastName}?`,
    );

    if (!confirmed) {
      return;
    }

    try {
      setChangingUserStatus(user.id);
      setActionMenuUserId(null);

      const response = await authedFetch(
        `${API_URL}/inventory-people/${user.id}/status`,
        {
          method: "PATCH",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            status: newStatus,
          }),
        },
      );

      if (!response.ok) {
        const errorData = await response.json().catch(() => null);

        throw new Error(
          errorData?.message || "No fue posible cambiar el estado del usuario.",
        );
      }

      /*
       * Actualización local inmediata.
       */

      setUsers((current) =>
        current.map((item) =>
          item.id === user.id
            ? {
                ...item,
                status: newStatus,
              }
            : item,
        ),
      );

      /*
       * Si el drawer de esta persona
       * está abierto, actualizarlo también.
       */

      setSelectedUser((current) => {
        if (current?.id !== user.id) {
          return current;
        }

        return {
          ...current,
          status: newStatus,
        };
      });

      /*
       * Confirmamos luego con backend.
       */

      await loadUsers();
    } catch (err) {
      console.error(err);

      alert(
        err instanceof Error
          ? err.message
          : "No fue posible cambiar el estado.",
      );
    } finally {
      setChangingUserStatus(null);
    }
  };
  const openAssignEquipment = async (
