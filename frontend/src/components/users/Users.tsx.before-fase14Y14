                disabled={importing}
                onClick={() => {
                  setShowImport(false);
                  setImportRows([]);
                }}
                className="rounded-xl border border-white/[0.08] px-4 py-2.5 text-sm text-slate-300"
              >
                Cancelar
              </button>

              <button
                type="button"
                disabled={importing || importRows.length === 0}
                onClick={confirmImport}
                className="flex items-center gap-2 rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-violet-500 disabled:opacity-50"
              >
                <FileSpreadsheet size={16} />

                {importing ? "Importando..." : "Confirmar importación"}
              </button>
            </div>
          </div>
        </Modal>
      )}

      {/* CREATE MODAL */}

      {showCreate && (
        <Modal title="Nuevo usuario" onClose={() => setShowCreate(false)}>
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <Field
              label="Employee ID *"
              value={newUser.employeeId}
              onChange={(value) =>
                setNewUser({
                  ...newUser,
                  employeeId: value,
                })
              }
            />

            <Field
              label="Nombre *"
              value={editUser.firstName}
              onChange={(value) =>
                setEditUser((current) => ({
                  ...current,
                  firstName: value,
                }))
              }
            />

            <Field
              label="Apellido *"
              value={newUser.lastName}
              onChange={(value) =>
                setNewUser({
                  ...newUser,
                  lastName: value,
                })
              }
            />

            <Field
              label="Correo"
              value={newUser.email}
              onChange={(value) =>
                setNewUser({
                  ...newUser,
                  email: value,
                })
              }
            />

            <Field
              label="Teléfono"
              value={newUser.phone}
              onChange={(value) =>
                setNewUser({
                  ...newUser,
                  phone: value,
                })
              }
            />
              <label className="space-y-2">
                <span className="text-xs font-medium text-slate-400">Cargo</span>
                <select value={newUser.jobTitle} onChange={(event) => setNewUser((current) => ({ ...current, jobTitle: event.target.value }))} className="h-11 w-full rounded-xl border border-white/[0.08] bg-[#1b2a43] px-3 text-sm text-white outline-none focus:border-violet-400/40">
                  <option value="">Sin cargo</option>
                  {newUser.jobTitle && !USER_JOB_TITLES.includes(newUser.jobTitle) && <option value={newUser.jobTitle}>{newUser.jobTitle} (actual)</option>}
                  {USER_JOB_TITLES.map((title) => <option key={title} value={title}>{title}</option>)}
                </select>
              </label>
          </div>

          <div className="mt-6 flex justify-end gap-2">
            <button
              type="button"
              onClick={() => setShowCreate(false)}
              className="rounded-xl border border-white/[0.08] px-4 py-2.5 text-sm text-slate-300"
            >
              Cancelar
            </button>

            <button
              type="button"
              onClick={createUser}
              className="rounded-xl bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-violet-500"
            >
              Crear usuario
            </button>
          </div>
        </Modal>
      )}
    </div>
  );
}

