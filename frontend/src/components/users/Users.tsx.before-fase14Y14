const isHeadsetLike = (value?: string | null) => {
  const normalized = (value || "")
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toUpperCase();

  return /HEADSET|HEADPHONE|AURICULAR|DIADEMA|AUDIFONO/.test(normalized);
};

type UserActivityItem = {
