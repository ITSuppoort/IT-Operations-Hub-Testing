        sheetName = "Usuarios Activos";

        fileSuffix = "Usuarios-Activos";

        break;

      case "inactive":
        sourceUsers = users.filter(
          (user) => user.status.toUpperCase() !== "ACTIVE",
        );

        sheetName = "Usuarios Inactivos";

        fileSuffix = "Usuarios-Inactivos";

        break;

      case "equipment":
        sheetName = "Equipos por Usuario";

        fileSuffix = "Equipos-por-Usuario";

        break;

      case "department":
        sheetName = "Por Departamento";

        fileSuffix = "Usuarios-por-Departamento";

        sourceUsers = [...users].sort((a, b) =>
          (a.department?.name || "").localeCompare(b.department?.name || ""),
        );

        break;

      default:
        sourceUsers = [...users];

        sheetName = "Roster Completo";

        fileSuffix = "Roster-Completo";
    }

    const rows = sourceUsers.map((user) => {
      const equipmentCount = Array.isArray(user.equipment)
        ? user.equipment.length
        : 0;

      return {
        "Employee ID": user.employeeId,

        Nombre: user.firstName,

        Apellido: user.lastName,

        "Nombre completo": `${user.firstName} ${user.lastName}`,

        Correo: user.email ?? "",

        Teléfono: user.phone ?? "",

        Cargo: user.jobTitle ?? "",

        Departamento: user.department?.name ?? "Sin departamento",

        Ubicación: getUserLocation(user),

        Estado: user.status,

        "Equipos asignados": equipmentCount,

        "Detalle equipos":
